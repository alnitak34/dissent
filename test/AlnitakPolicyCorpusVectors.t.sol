pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {AlnitakPolicyBountyRecomputer} from "../src/adapters/AlnitakPolicyBountyRecomputer.sol";

/// @notice Differential vectors exported from all 11 eligible states in the
///         frozen S17 + S18 corpus. Expected values come from the independent
///         standard-library Python verifier, not from this Solidity contract.
contract AlnitakPolicyCorpusVectorsTest is Test {
    AlnitakPolicyBountyRecomputer internal rc;

    function setUp() public {
        rc = new AlnitakPolicyBountyRecomputer();
    }

    function _check(
        bytes memory evidence,
        uint256 oldEquity,
        uint256 conditionedEquity,
        uint256 threshold,
        bool violation
    ) internal view {
        bytes memory inputs = rc.canonicalInputs();
        (bool ok, bytes32 reason) = rc.validateEvidence(inputs, evidence);
        assertTrue(ok);
        assertEq(reason, bytes32(0));
        AlnitakPolicyBountyRecomputer.Evaluation memory value = rc.evaluate(inputs, evidence);
        assertEq(value.oldEquityWad, oldEquity);
        assertEq(value.conditionedEquityWad, conditionedEquity);
        assertEq(value.thresholdWad, threshold);
        assertEq(value.violation, violation);
        assertEq(rc.recompute(inputs, evidence), violation ? int256(1) : int256(0));
    }

    function test_cmtmqygwvm8hv_25() public view {
        _check(
            hex"",
            983394833948339483,
            943750000000000000,
            266412213740458015,
            false
        );
    }

